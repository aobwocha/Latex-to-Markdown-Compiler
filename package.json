{
  "name": "latex-parser-service",
  "version": "1.0.0",
  "description": "High-performance C LaTeX parser wrapped in a TypeScript Express microservice",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "build:c": "make",
    "build:ts": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "clean": "make clean && rm -rf dist"
  },
  "keywords": [
    "latex",
    "parser",
    "markdown",
    "microservice",
    "express"
  ],
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
